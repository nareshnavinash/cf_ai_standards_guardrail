{
  "name": "cf-ai-standards-guardrail",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": { "DAILY_LLM_REVIEWS": "12" },
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "workflows": [
    { "name": "review-workflow", "binding": "REVIEW_WORKFLOW", "class_name": "ReviewWorkflow" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "REPO_MEMORY", "class_name": "RepoMemory" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepoMemory"] }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "9a451643e0c243a7a07c2ffd654dc756" }],
  "ratelimits": [
    { "name": "REVIEW_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "CHAT_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ]
}
