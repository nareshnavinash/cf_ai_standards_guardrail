{
  "name": "cf-ai-standards-guardrail-e2e",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    "DAILY_NEURON_BUDGET": "0",
    "DAILY_LLM_REVIEWS": "10",
    "DAILY_CHAT_TURNS": "40",
    "IP_DAILY_REVIEWS": "4",
    "IP_DAILY_REVIEWS_TOTAL": "100000",
    "IP_DAILY_CHATS": "15"
  },
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "workflows": [
    { "name": "review-workflow", "binding": "REVIEW_WORKFLOW", "class_name": "ReviewWorkflow" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REPO_MEMORY", "class_name": "RepoMemory" },
      { "name": "CONTROL", "class_name": "Control" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RepoMemory"] },
    { "tag": "v2", "new_sqlite_classes": ["Control"] }
  ],
  "kv_namespaces": [{ "binding": "CACHE" }]
}
